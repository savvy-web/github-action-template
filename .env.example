# Copy to `.env` (git-ignored) and fill in. `.envrc` loads it via direnv.

# === REQUIRED ===
# Used by the GitHub CLI and any GitHub MCP server you configure locally.
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_token_here"

# === OPTIONAL ===
GITHUB_HOST="https://github.com"
CLAUDE_DEBUG="true"
NODE_ENV="development"
